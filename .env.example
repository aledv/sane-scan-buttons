# --- Scanner ---
# SANE backend(s) for your scanner, comma separated (genesys = Canon LiDE 100/110/..., see `scanimage -L`)
SANE_BACKENDS=genesys
# Use the first device whose name starts with this (empty = first device found)
SANE_DEVICE_PREFIX=genesys:
# Button option names as reported by `scanimage -A` (the "Sensors" section)
BUTTONS=scan,file,email,copy

# --- What each button does: consume, folder, email, print or none ---
ACTION_SCAN=consume
ACTION_FILE=folder
ACTION_EMAIL=email
ACTION_COPY=print

# --- Scan settings ---
SCAN_MODE=Color
SCAN_RESOLUTION=300
SCAN_WIDTH_MM=210
SCAN_HEIGHT_MM=297
PAGE_SIZE=A4
FILE_PREFIX=Scan

# --- Output ownership (uid:gid) ---
# consume: Paperless-ngx usually runs as 1000; folder: Nextcloud's www-data is 33
CONSUME_OWNER=1000:1000
FOLDER_OWNER=33:33
FOLDER_MODE=640
# Optional: touch this file after saving to /output (e.g. a flag a cron job uses to run `occ files:scan`)
FOLDER_FLAG=

# --- Notifications and email: base URL of a notify-relay (https://github.com/aledv/notify-relay) ---
NOTIFY_URL=
EMAIL_SUBJECT=New scan
EMAIL_SENDER=
EMAIL_SENDER_NAME=Scanner

# --- Printing (COPY): CUPS queue name, empty = default destination; CUPS_SERVER in docker-compose.yml ---
PRINTER=

# --- Messages: en or it ---
LANGUAGE=en

# --- Share the scanner with a web UI (scanservjs) through saned: allowed hosts/networks ---
SANED_ENABLE=1
SANED_ALLOW=127.0.0.1,172.16.0.0/12

TZ=Europe/London
